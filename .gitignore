# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# raw Overpass responses cached by scripts/import-osm.mjs
/scripts/.cache/

# keep the example env file (the .env* rule above would otherwise hide it)
!.env.local.example

# cloudflare / opennext build output
/.open-next/
/.wrangler/
/.dist/

# unrelated personal documents that happen to live in this folder —
# excluded so they are never published to the public repo
/deepfake_detection_paper_draft.docx
/deepfake_papers_comparison.png
/draft_paper_methodology_technical.pdf
/draft_paper_title_to_literature_review.pdf
/literature_survey_deepfake.pptx
/problem_statement_methodology.pdf
